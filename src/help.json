{
  "title": "Custom MIDI Control",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Custom MIDI control",
        "for Schwung on",
        "Move.",
        "",
        "16 banks of",
        "configurable pads,",
        "knobs, buttons",
        "",
        "Three output modes:",
        " external, move,",
        " schwung"
      ]
    },
    {
      "title": "Launch",
      "lines": [
        "Open from Tools Menu:",
        " Shift + Step 13"
      ]
    },
    {
      "title": "Navigation",
      "lines": [
        "Back: Exit",
        "Menu: Settings",
        "Step 1-16: Bank",
        "",
        "In Settings:",
        "Back: Exit",
        "Jog: Scroll",
        "Jog click: Edit"
      ]
    },
    {
      "title": "Settings - Pad",
      "lines": [
        "Select pad: press it",
        "",
        "Note/CC: value",
        "Name: Custom label",
        "Colour: LED (0-127)",
        "Pad Level: %",
        "MIDI Ch: Bank/1-16",
        "Choke Grp: 0-8",
        "Pad Offs: Bank/",
        " On/On-Only/Tog",
        "Pad Mode: Bank/",
        " Note/CC",
        "Output: Bank/",
        " ext/move/sch"
      ]
    },
    {
      "title": "Settings - Knob",
      "lines": [
        "Select knob: touch it",
        "",
        "CC: MIDI CC",
        "Name: Custom label",
        "MIDI Ch: Bank/1-16",
        "Colour: Scheme (0-3)",
        "Min/Max: Range",
        "Multiplier: 0.25x-8x",
        "CC Relative: On/Off",
        "Page Name: label",
        " (knob pages on)"
      ]
    },
    {
      "title": "Settings - Button",
      "lines": [
        "Select button: press",
        "",
        "CC: MIDI CC",
        "Name: Custom label",
        "MIDI Ch: Bank/1-16",
        "Colour: LED colour",
        "Button Offs: Bank/",
        " On/On-Only/Tog"
      ]
    },
    {
      "title": "Settings - Bank",
      "lines": [
        "Select bank: press",
        "",
        "Name: Custom label",
        "MIDI Ch: 1-16",
        "Master Pad Level: %",
        "Min Pad Level: 0-127",
        "Pad Offs: On/Off/Tog",
        "Pad Mode: Note/CC",
        "Knob Pages: On/Off",
        "Pad Pages: Off/Up/",
        " Up-Hold/Jog",
        "Pad Layout: Off/",
        " Chrom/+4/+5",
        "MIDI In: On/Off",
        "Scenes: On/Off",
        "Button Offs: On",
        " On-Only/Tog",
        "Output: ext/move/sch",
        "Show Overlay: On/Off",
        "H/light: Slight Dim,",
        "Full Dim, Black,",
        "White, Lt Grey,",
        "Dk Grey, Blue,",
        "Green, Red, None"
      ]
    },
    {
      "title": "Bank vs Individual",
      "lines": [
        "Bank settings apply",
        "to all pads/knobs/",
        "buttons.",
        "",
        "Individual settings",
        "override bank ones.",
        "",
        "Changing a bank",
        "setting clears the",
        "matching individual",
        "override."
      ]
    },
    {
      "title": "Output Modes",
      "lines": [
        "external: USB MIDI",
        " move: Move synths",
        " schwung: Schwung",
        "",
        "Different banks can",
        "use different"
      ]
    },
    {
      "title": "Velocity",
      "lines": [
        "Output = Input ×",
        " (Pad Level / 100)",
        " (Master Level / 100)",
        "",
        "Capped at 127,",
        "min at Bank's Min"
      ]
    },
    {
      "title": "Choke Groups",
      "lines": [
        "Pads in same group",
        "cut each other off.",
        "",
        "Perfect for hi-hats:",
        "Pad 1: Closed (Grp 1)",
        "Pad 2: Open (Grp 1)"
      ]
    },
    {
      "title": "Knob Pages",
      "lines": [
        "Bank setting.",
        "When on, pads",
        "25-32 select one",
        "of 8 knob pages.",
        "",
        "Pad 25 = page 1",
        "(existing knobs).",
        "Pages 2-8 add",
        "7x8 knob maps.",
        "Master knob is",
        "shared.",
        "",
        "Pad 25-32 config",
        "is preserved."
      ]
    },
    {
      "title": "Pad Pages",
      "lines": [
        "Bank setting.",
        "Second page of 32",
        "pads (64 total).",
        "",
        "Controls:",
        "Up Toggle: press +",
        "Up Hold: hold +",
        "Jog Toggle: click",
        "jog wheel",
        "",
        "Exclusive with",
        "Knob Pages +",
        "Layout (within a",
        "scene). State",
        "kept per page."
      ]
    },
    {
      "title": "Keyboard",
      "lines": [
        "Pad Layout bank",
        "setting turns all",
        "32 pads into a",
        "keyboard:",
        " Chromatic,",
        " Rows+4 or +5",
        " (guitar/Push)",
        "",
        "Up/Down: octave",
        "shift.",
        "KB Root: base note",
        "(default C2).",
        "",
        "White = C, grey =",
        "natural, dark =",
        "sharp/flat.",
        "Pressing lights",
        "all pads with the",
        "same note.",
        "",
        "Exclusive with",
        "Knob/Pad Pages."
      ]
    },
    {
      "title": "MIDI In",
      "lines": [
        "Bank setting.",
        "Incoming external",
        "CCs update control",
        "state + LEDs.",
        "",
        "Matches CC + ch",
        "across all banks",
        "and knob pages.",
        "",
        "Knobs pick up from",
        "synced values.",
        "Nothing is re-sent."
      ]
    },
    {
      "title": "Scenes",
      "lines": [
        "Bank setting.",
        "Row1-4 buttons",
        "switch between 4",
        "sub-banks - each",
        "has the full bank",
        "option set (pads,",
        "knobs, pages,",
        "layout, MIDI In).",
        "",
        "Active scene stays",
        "lit; overlay shows",
        "Bank / Scene.",
        "Rename via Name.",
        "",
        "Row1-4 are not",
        "mappable while on."
      ]
    },
    {
      "title": "Relative Knobs",
      "lines": [
        "Absolute (default):",
        " Position = Value",
        "",
        "Relative:",
        " Turn = +/- change",
        " No jumping"
      ]
    },
    {
      "title": "Visual Feedback",
      "lines": [
        "White pulse: Selected",
        "White flash: Pad hit",
        "Knob LEDs: Value",
        "Step LEDs: Active"
      ]
    },
    {
      "title": "Configuration",
      "lines": [
        "Stored at:",
        " /data/UserData/",
        " schwung/",
        " modules/overtake/",
        " control/config.json",
        "",
        "Backup via SCP/SFTP"
      ]
    }
  ]
}
